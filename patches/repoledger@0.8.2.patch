+function readProgressHistory(root, migration, primary) {
+  const result = runGit(root, [
+    "log",
+    "--first-parent",
+    "--reverse",
+    "--diff-merges=first-parent",
+    "-z",
+    "--format=%x00%x00%H%x00%B%x00",
+    "--name-only",
+    `${migration}..${primary}`,
+  ]);
+  if (!result.ok || !result.stdout) return null;
+  const tokens = result.stdout.split("\0");
+  const records = [];
+  for (let index = 0; index < tokens.length;) {
+    if (tokens[index] !== "" || tokens[index + 1] !== "" || !/^[0-9a-f]{40}$/.test(tokens[index + 2] ?? "")) {
+      index += 1;
+      continue;
+    }
+    const commit = tokens[index + 2];
+    const message = tokens[index + 3] ?? "";
+    const paths = [];
+    index += 4;
+    while (index < tokens.length) {
+      if (tokens[index] === "" && tokens[index + 1] === "" && /^[0-9a-f]{40}$/.test(tokens[index + 2] ?? "")) break;
+      const path = tokens[index].replace(/^\r?\n/, "");
+      if (path) paths.push(path);
+      index += 1;
+    }
+    records.push({ commit, message, paths });
+  }
+  return records;
