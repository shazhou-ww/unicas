{
  "name": "@unicas/space-protocol",
  "version": "0.1.0",
  "description": "UniCAS App/Space v2 and frozen Stack/Tenant v1 data-plane contracts and capability vocabulary",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./src/v1.ts",
      "development": "./src/v1.ts",
      "import": "./dist/v1.js",
      "default": "./dist/v1.js"
    },
    "./openapi-v1.json": "./openapi/tenant-v1.openapi.json",
    "./openapi-v2.json": "./openapi/space-v2.openapi.json"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsc",
    "docs:generate": "tsx scripts/generate-openapi.ts",
    "docs:generate:v2": "tsx scripts/generate-space-openapi.ts",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\""
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./v1": {
        "types": "./dist/v1.d.ts",
        "import": "./dist/v1.js"
      },
      "./openapi-v1.json": "./openapi/tenant-v1.openapi.json",
      "./openapi-v2.json": "./openapi/space-v2.openapi.json"
    }
  },
  "dependencies": {
    "@orpc/contract": "1.15.0",
    "@orpc/openapi": "1.15.0",
    "@orpc/zod": "1.15.0",
    "jose": "^6.2.10",
    "zod": "^4.4.3"
  }
}