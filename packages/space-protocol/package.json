{
  "name": "@unicas/space-protocol",
  "version": "0.0.0-bootstrap.0",
  "description": "UniCAS App/Space v1 data-plane contracts and capability vocabulary",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/unicas.git",
    "directory": "packages/space-protocol"
  },
  "bugs": {
    "url": "https://github.com/shazhou-ww/unicas/issues"
  },
  "homepage": "https://docs.unicas.work/app-user-api/",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./openapi/app-space-v1.openapi.json"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsc",
    "docs:generate": "tsx scripts/generate-space-openapi.ts",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\""
  },
  "devDependencies": {
    "@orpc/openapi": "1.15.0",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./openapi.json": "./openapi/app-space-v1.openapi.json"
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@orpc/contract": "1.15.0",
    "@orpc/zod": "1.15.0",
    "jose": "^6.2.10",
    "zod": "^4.4.3"
  }
}