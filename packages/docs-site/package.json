{
  "name": "@unicas/docs-site",
  "version": "0.1.0",
  "private": true,
  "description": "Independently built and deployed UniCAS documentation site",
  "type": "module",
  "scripts": {
    "build": "node src/build.mjs",
    "test": "vitest run --root . tests/docs-site.test.mjs",
    "test:browser": "pnpm run build && playwright test --config playwright.config.mjs",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist .playwright test-results \"*.tsbuildinfo\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@unicas/space-protocol": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@scalar/api-reference": "1.73.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "marked": "^18.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}