{
  "name": "@unicas/admin-protocol",
  "version": "0.1.0",
  "description": "Cloud-neutral App administrator HTTP contracts",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./openapi-v2.json": "./openapi/admin-v2.openapi.json"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsc",
    "docs:generate:v2": "tsx scripts/generate-app-openapi.ts",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\""
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./openapi-v2.json": "./openapi/admin-v2.openapi.json"
    }
  },
  "dependencies": {
    "@unicas/space-protocol": "workspace:*",
    "@orpc/contract": "1.15.0",
    "@orpc/openapi": "1.15.0",
    "@orpc/zod": "1.15.0",
    "zod": "^4.4.3"
  }
}