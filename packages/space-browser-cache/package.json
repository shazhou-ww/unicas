{
  "name": "@unicas/space-browser-cache",
  "version": "0.2.0",
  "description": "Browser persistence strategy for immutable UniCAS node reads",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/unicas.git",
    "directory": "packages/space-browser-cache"
  },
  "bugs": {
    "url": "https://github.com/shazhou-ww/unicas/issues"
  },
  "homepage": "https://docs.unicas.work/app-user-api/sdk/#space-browser-cache",
  "keywords": [
    "unicas",
    "content-addressed-storage",
    "indexeddb",
    "browser-cache",
    "typescript",
    "esm"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@unicas/space-client": "workspace:*",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}