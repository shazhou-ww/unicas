{
  "name": "@unicas/service-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "Unified UniCAS service deployment for Cloudflare Workers",
  "type": "module",
  "main": "./src/worker.ts",
  "types": "./src/worker.ts",
  "exports": {
    ".": {
      "types": "./src/worker.ts",
      "development": "./src/worker.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @unicas/admin-webui build:ui && node scripts/build-ui-assets.mjs && tsc -b",
    "test": "pnpm --filter @unicas/admin-webui build:ui && node scripts/build-ui-assets.mjs && vitest run --testTimeout=15000",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\" src/admin-bff/ui-assets.generated.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@unicas/admin-protocol": "workspace:*",
    "@unicas/codec": "workspace:*",
    "@unicas/control-auth": "workspace:*",
    "@unicas/observability": "workspace:*",
    "@unicas/service": "workspace:*",
    "@unicas/space-protocol": "workspace:*",
    "agents": "0.26.0",
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250817.0",
    "jose": "^6.2.12",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}