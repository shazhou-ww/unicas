{
  "name": "@unicas/space-client",
  "version": "0.1.0",
  "description": "Cloud-neutral HTTP client for UniCAS App/Space v2 and frozen Stack/Tenant v1 data planes",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./src/v1.ts",
      "development": "./src/v1.ts",
      "import": "./dist/v1.js",
      "default": "./dist/v1.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@unicas/space-protocol": "workspace:*",
    "@unicas/codec": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./v1": {
        "types": "./dist/v1.d.ts",
        "import": "./dist/v1.js"
      }
    }
  }
}