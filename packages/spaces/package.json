{
  "name": "@unicas/spaces",
  "version": "0.1.0",
  "private": true,
  "description": "Independently deployed UniCAS file upload smoke App",
  "type": "module",
  "main": "./src/worker.ts",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run --root .",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.test.json",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@unicas/observability": "workspace:*",
    "@unicas/space-client": "workspace:*",
    "@unicas/space-file-client": "workspace:*",
    "@unicas/space-protocol": "workspace:*",
    "jose": "^6.2.10",
    "lucide-react": "^1.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}