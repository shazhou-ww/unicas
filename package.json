{
  "name": "unicas",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @unicas/service-cloudflare build && node stacks/unicas/local/dev.mjs",
    "deploy": "node stacks/unicas/deploy/deploy.mjs",
    "deploy:production": "node stacks/unicas/deploy/deploy.mjs --production",
    "deploy:plan": "node stacks/unicas/deploy/deploy.mjs --dry-run",
    "deploy:site": "pnpm --filter @unicas/service-cloudflare exec wrangler deploy --config ../../stacks/unicas/site/wrangler.jsonc",
    "deploy:site:plan": "pnpm --filter @unicas/service-cloudflare exec wrangler deploy --dry-run --config ../../stacks/unicas/site/wrangler.jsonc",
    "deploy:spaces": "node stacks/unicas/spaces/deploy.mjs --production",
    "deploy:spaces:bootstrap": "node stacks/unicas/spaces/deploy.mjs --bootstrap",
    "deploy:spaces:plan": "node stacks/unicas/spaces/deploy.mjs --dry-run",
    "docs:build": "pnpm --filter @unicas/docs-site build",
    "docs:check": "pnpm --filter @unicas/docs-site test",
    "deploy:docs": "pnpm --filter @unicas/docs-site deploy",
    "deploy:docs:plan": "pnpm --filter @unicas/docs-site deploy:plan",
    "smoke": "node stacks/unicas/deploy/smoke.mjs",
    "spaces:smoke": "node packages/spaces/scripts/smoke.mjs",
    "spaces:bootstrap": "pnpm --filter @unicas/spaces^... build && pnpm --filter @unicas/spaces build && node stacks/unicas/spaces/deployment-config.mjs && node packages/spaces/scripts/bootstrap.mjs",
    "spaces:issuer-proof": "node packages/spaces/scripts/sign-issuer-challenge.mjs",
    "build": "pnpm -r build",
    "test": "pnpm test:exhaustive",
    "test:exhaustive": "pnpm check:repo && pnpm test:packages",
    "test:packages": "pnpm -r test",
    "test:quick": "pnpm check:repo && pnpm --filter \"!@unicas/service-cloudflare\" -r test",
    "check:repo": "pnpm check:tasks && vitest run tests/deploy-plan.test.mjs tests/workspace-boundaries.test.mjs tests/openapi-drift.test.ts tests/app-space-v1-cutover.test.mjs tests/app-space-v1-issuer-cutover.test.mjs tests/stack-tenant-retirement.test.mjs tests/sdk-release.test.mjs tests/npm-release.test.mjs",
    "check:workspace": "vitest run tests/workspace-boundaries.test.mjs tests/deploy-plan.test.mjs tests/stack-tenant-retirement.test.mjs",
    "check:openapi": "vitest run tests/openapi-drift.test.ts",
    "check:api-version": "vitest run tests/app-space-v1-cutover.test.mjs",
    "check:retirement": "vitest run tests/stack-tenant-retirement.test.mjs",
    "sdk:prepare": "node scripts/prepare-sdk-release.mjs --write",
    "sdk:artifacts": "node scripts/prepare-sdk-release.mjs --check --output-dir .sdk-release",
    "check:sdk-release": "vitest run tests/sdk-release.test.mjs && node scripts/prepare-sdk-release.mjs --check",
    "check:npm-release": "vitest run tests/npm-release.test.mjs",
    "check:tasks": "repoledger check",
    "check:tasks:commit": "repoledger check --commit HEAD",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r run clean",
    "keys:local": "node scripts/generate-local-capability-keys.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "jose": "^6.2.10",
    "miniflare": "5.20260811.1-alpha",
    "repoledger": "github:shazhou-ww/repoledger#25fbe948f6f7d08ad2b6b8175c4fe71e61132a48",
    "rimraf": "^6.1.3",
    "semver": "7.8.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}