{
  "name": "unicas",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @unicas/service-cloudflare build && node stacks/unicas/local/dev.mjs",
    "release:service:plan": "node release/service/deploy.mjs --dry-run",
    "release:service:production": "node release/service/deploy.mjs --production",
    "release:service:smoke": "node release/service/smoke.mjs",
    "release:spaces:plan": "node release/spaces/deploy.mjs --dry-run",
    "release:spaces:production": "node release/spaces/deploy.mjs --production",
    "release:spaces:bootstrap-deploy": "node release/spaces/deploy.mjs --bootstrap",
    "release:spaces:bootstrap-data": "pnpm --filter @unicas/spaces^... build && pnpm --filter @unicas/spaces build && node release/spaces/deployment-config.mjs && node release/spaces/bootstrap.mjs",
    "release:spaces:smoke": "node release/spaces/smoke.mjs",
    "release:spaces:issuer-proof": "node release/spaces/sign-issuer-challenge.mjs",
    "release:site:plan": "node release/site/deploy.mjs --dry-run",
    "release:site:production": "node release/site/deploy.mjs --production",
    "release:docs:plan": "node release/docs/deploy.mjs --dry-run",
    "release:docs:production": "node release/docs/deploy.mjs --production",
    "release:sdk:prepare": "node release/app-user-sdk/prepare-sdk-release.mjs --write",
    "release:sdk:artifacts": "node release/app-user-sdk/prepare-sdk-release.mjs --check --output-dir .sdk-release",
    "release:sdk:check": "vitest run tests/sdk-release.test.mjs tests/sdk-readiness.test.mjs && node release/app-user-sdk/prepare-sdk-release.mjs --check",
    "release:sdk:readiness": "vitest run tests/sdk-readiness.test.mjs",
    "release:sdk:npm-check": "vitest run tests/npm-release.test.mjs",
    "release:sdk:npm-verify": "node release/app-user-sdk/verify-npm-release.mjs",
    "docs:build": "pnpm --filter @unicas/docs-site build",
    "docs:check": "pnpm --filter @unicas/docs-site test",
    "build": "pnpm -r build",
    "test": "pnpm test:exhaustive",
    "test:exhaustive": "pnpm check:repo && pnpm check:release && pnpm test:packages",
    "validate": "pnpm test:quick && pnpm build && pnpm typecheck",
    "validate:release": "pnpm validate && pnpm check:release && pnpm --filter @unicas/service-cloudflare test && pnpm release:sdk:artifacts && pnpm --filter @unicas/docs-site test:browser && pnpm release:service:plan && pnpm --filter @unicas/service-cloudflare exec wrangler deploy --dry-run && pnpm release:spaces:plan && pnpm release:site:plan && pnpm release:docs:plan",
    "test:packages": "pnpm -r test",
    "test:quick": "pnpm check:repo && pnpm --filter \"!@unicas/service-cloudflare\" -r test",
    "check:repo": "pnpm check:ideas && vitest run tests/agent-guidance.test.mjs tests/deploy-plan.test.mjs tests/workspace-boundaries.test.mjs tests/openapi-drift.test.ts tests/stack-tenant-retirement.test.mjs tests/sdk-readiness.test.mjs && vitest run tests/release-gated-ci.test.mjs",
    "check:release": "vitest run tests/app-space-v1-cutover.test.mjs tests/app-space-v1-issuer-cutover.test.mjs tests/sdk-release.test.mjs tests/npm-release.test.mjs tests/sdk-readiness.test.mjs tests/spaces-release-bootstrap.test.mjs tests/spaces-release-smoke.test.mjs",
    "check:workspace": "vitest run tests/workspace-boundaries.test.mjs tests/deploy-plan.test.mjs tests/stack-tenant-retirement.test.mjs",
    "check:agent-guidance": "vitest run tests/agent-guidance.test.mjs",
    "check:openapi": "vitest run tests/openapi-drift.test.ts",
    "check:api-version": "vitest run tests/app-space-v1-cutover.test.mjs",
    "check:retirement": "vitest run tests/stack-tenant-retirement.test.mjs",
    "check:release-gated-ci": "vitest run tests/release-gated-ci.test.mjs",
    "hooks:install": "node scripts/git-hooks.mjs install",
    "hooks:uninstall": "node scripts/git-hooks.mjs uninstall",
    "hooks:status": "node scripts/git-hooks.mjs status",
    "check:ideas": "silvermoon check --worktree --audience agent",
    "check:ideas:commit": "silvermoon check --commit HEAD --audience agent",
    "check:ideas:remote": "silvermoon check --remote --audience agent",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r run clean",
    "keys:local": "node scripts/generate-local-capability-keys.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "^24.0.0",
    "@unicas/space-client": "workspace:*",
    "@unicas/space-file-client": "workspace:*",
    "@unicas/space-protocol": "workspace:*",
    "esbuild": "^0.28.2",
    "jose": "^6.2.10",
    "miniflare": "5.20260811.1-alpha",
    "rimraf": "^6.1.3",
    "semver": "7.8.5",
    "silvermoon": "^0.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}